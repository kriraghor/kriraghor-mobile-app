{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "API_URL": "http://10.0.2.2:4000/api/v1",
        "REALTIME_URL": "http://10.0.2.2:4001",
        "WEB_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "API_URL": "https://api.staging.kriraghor.com/api/v1",
        "REALTIME_URL": "https://api.staging.kriraghor.com",
        "WEB_URL": "https://www.staging.kriraghor.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "API_URL": "https://api.kriraghor.com/api/v1",
        "REALTIME_URL": "https://api.kriraghor.com",
        "WEB_URL": "https://www.kriraghor.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
