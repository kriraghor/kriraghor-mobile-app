{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "API_URL": "http://10.0.2.2:4000/api/v1",
        "REALTIME_URL": "http://10.0.2.2:4001",
        "WEB_URL": "http://10.0.2.2:3000",
        "GYM_URL": "http://10.0.2.2:3003"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "API_URL": "https://api.kriraghor.com/api/v1",
        "REALTIME_URL": "https://kriraghor-realtime.onrender.com",
        "WEB_URL": "https://kriraghor.com",
        "GYM_URL": "https://gym.kriraghor.com"
      }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "API_URL": "https://api.kriraghor.com/api/v1",
        "REALTIME_URL": "https://kriraghor-realtime.onrender.com",
        "WEB_URL": "https://kriraghor.com",
        "GYM_URL": "https://gym.kriraghor.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}